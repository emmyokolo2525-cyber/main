{
  "name": "@harpocrates/cli",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "harpocrates": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
