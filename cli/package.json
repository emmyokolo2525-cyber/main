    "./receipt": "./dist/receipt.js",
    "./normalize": "./dist/normalize.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.7"
  }
